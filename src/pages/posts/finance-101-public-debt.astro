---
import DarkInfographicLayout from '../../layouts/DarkInfographicLayout.astro';

export const metadata = {
  title: 'Finance 101: Nợ Công — Tại Sao Nhật Nợ 250% GDP Vẫn Đứng Vững Còn Hy Lạp Vỡ Nợ Ở 130%',
  description: 'Nợ công không nguy hiểm vì con số lớn. Nó nguy hiểm khi bạn nợ bằng tiền của người khác, theo lãi suất bạn không kiểm soát — và đó là khác biệt giữa Mỹ, Nhật, Trung Quốc và Việt Nam.',
  pubDate: new Date('2026-06-13'),
  tags: ['finance', 'economics'],
  theme: 'dark-infographic',
  draft: false,
};
---

<DarkInfographicLayout
  title={metadata.title}
  description={metadata.description}
  pubDate={metadata.pubDate}
  tags={metadata.tags}
  kicker="Tài Chính Cơ Bản"
  kickerColor="cyan"
>
  <style>
    /* ─── Popovers ─────────────────────────────── */
    .popover-wrap { position: relative; display: inline; }
    .popover-trigger {
      color: rgb(34 211 238);
      border-bottom: 1px dashed rgba(34, 211, 238, 0.4);
      cursor: help; background: none;
      border-top: none; border-left: none; border-right: none;
      font: inherit; padding: 0;
    }
    .popover-trigger:hover { border-bottom-color: rgb(34 211 238); }
    .popover-bubble {
      display: none; position: absolute;
      bottom: calc(100% + 8px); left: 50%;
      transform: translateX(-50%); width: 290px;
      padding: 12px 14px; background: #1a2744;
      border: 1px solid rgba(34, 211, 238, 0.25);
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      font-size: 0.8rem; line-height: 1.5;
      color: rgb(203 213 225); z-index: 50; text-align: left;
    }
    .popover-bubble::after {
      content: ''; position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 6px solid transparent;
      border-top-color: rgba(34, 211, 238, 0.25);
    }
    .popover-bubble.show { display: block; }
    @media (max-width: 640px) {
      .popover-bubble { width: 230px; left: 0; transform: none; }
      .popover-bubble::after { left: 20px; transform: none; }
    }

    /* ─── Expand blocks ────────────────────────── */
    .expand-block {
      border: 1px solid rgba(100, 116, 139, 0.3);
      background: rgba(21, 31, 50, 0.3); margin: 1rem 0;
    }
    .expand-block summary {
      cursor: pointer; padding: 12px 16px;
      font-size: 0.85rem; font-weight: 600;
      color: rgb(148 163 184);
      display: flex; align-items: center; gap: 8px;
      list-style: none; user-select: none; transition: color 0.2s;
    }
    .expand-block summary::-webkit-details-marker { display: none; }
    .expand-block summary:hover { color: rgb(226 232 240); }
    .expand-block summary .chevron { transition: transform 0.25s; flex-shrink: 0; }
    .expand-block[open] summary .chevron { transform: rotate(90deg); }
    .expand-block .expand-content {
      padding: 0 16px 16px;
      font-size: 0.9rem; line-height: 1.7; color: rgb(203 213 225);
    }

    /* ─── Bar chart ────────────────────────────── */
    .bar-track {
      height: 28px; background: rgba(30, 41, 59, 0.8);
      position: relative; overflow: hidden;
    }
    .bar-fill { height: 100%; }

    /* ─── Timeline ─────────────────────────────── */
    .timeline { position: relative; padding-left: 28px; }
    .timeline::before {
      content: ''; position: absolute; left: 6px; top: 8px; bottom: 8px;
      width: 2px; background: rgba(34, 211, 238, 0.2);
    }
    .timeline-item { position: relative; margin-bottom: 20px; }
    .timeline-item::before {
      content: ''; position: absolute; left: -24px; top: 6px;
      width: 10px; height: 10px; border-radius: 50%;
      background: #0B1221; border: 2px solid rgba(34, 211, 238, 0.5);
    }
    .timeline-item.highlight::before {
      background: rgb(34, 211, 238); border-color: rgb(34, 211, 238);
      box-shadow: 0 0 8px rgba(34, 211, 238, 0.6);
    }
    .timeline-item.danger::before {
      background: rgb(239, 68, 68); border-color: rgb(239, 68, 68);
      box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
    }
    .timeline-item.gold::before {
      background: rgb(251, 191, 36); border-color: rgb(251, 191, 36);
      box-shadow: 0 0 8px rgba(251, 191, 36, 0.5);
    }
    .timeline-year {
      font-size: 0.72rem; font-weight: 700; font-family: monospace;
      color: rgb(34, 211, 238); letter-spacing: 0.05em; margin-bottom: 2px;
    }
    .timeline-item.danger .timeline-year { color: rgb(252, 165, 165); }
    .timeline-item.gold .timeline-year { color: rgb(251, 191, 36); }
    .timeline-desc {
      font-size: 0.9rem; line-height: 1.5; color: rgb(203 213 225);
    }
    .timeline-item.highlight .timeline-desc { color: white; font-weight: 600; }
    .timeline-item.danger .timeline-desc { color: rgb(254 226 226); font-weight: 600; }
    .timeline-item.gold .timeline-desc { color: rgb(254 243 199); font-weight: 600; }

    /* ─── Stats grid ───────────────────────────── */
    .stat-card {
      background: rgba(21, 31, 50, 0.5);
      border: 1px solid rgba(34, 211, 238, 0.15);
      padding: 20px; text-align: center;
    }
    .stat-num {
      font-size: 2rem; font-weight: 900; color: rgb(34, 211, 238);
      line-height: 1; margin-bottom: 6px;
    }
    .stat-label {
      font-size: 0.75rem; color: rgb(100 116 139);
      text-transform: uppercase; letter-spacing: 0.06em;
    }

    /* ─── Comparison table ─────────────────────── */
    .compare-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .compare-table th {
      padding: 10px 12px; background: rgba(21, 31, 50, 0.8);
      color: rgb(148 163 184); font-weight: 700; text-align: left;
      border-bottom: 1px solid rgba(100,116,139,0.3);
      font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;
    }
    .compare-table td {
      padding: 10px 12px; border-bottom: 1px solid rgba(100,116,139,0.15);
      color: rgb(203 213 225); vertical-align: top;
    }
    .compare-table tr:last-child td { border-bottom: none; }
    .compare-table tr:hover td { background: rgba(34, 211, 238, 0.03); }
    .compare-table .col-metric { color: white; font-weight: 600; }
    .compare-table .good { color: rgb(74, 222, 128); }
    .compare-table .bad { color: rgb(252, 165, 165); }
    .compare-table .neutral { color: rgb(251, 191, 36); }

    /* ─── Red flags ────────────────────────────── */
    .redflag-item {
      display: flex; gap: 12px; align-items: flex-start;
      padding: 14px; border: 1px solid rgba(239, 68, 68, 0.2);
      background: rgba(239, 68, 68, 0.03); margin-bottom: 10px;
    }
    .redflag-icon { color: rgb(239 68 68); flex-shrink: 0; margin-top: 2px; }
    .redflag-text { font-size: 0.92rem; line-height: 1.6; color: rgb(203 213 225); }
    .redflag-text strong { color: white; }

    /* ─── Inline highlights ────────────────────── */
    .hl {
      background: rgba(34, 211, 238, 0.12);
      color: rgb(34, 211, 238);
      font-weight: 700;
      padding: 1px 5px;
      border-bottom: 1px solid rgba(34, 211, 238, 0.35);
    }
    .hl-gold {
      background: rgba(251, 191, 36, 0.12);
      color: rgb(251, 191, 36);
      font-weight: 700;
      padding: 1px 5px;
      border-bottom: 1px solid rgba(251, 191, 36, 0.35);
    }
    .hl-red {
      background: rgba(239, 68, 68, 0.12);
      color: rgb(252, 165, 165);
      font-weight: 700;
      padding: 1px 5px;
      border-bottom: 1px solid rgba(239, 68, 68, 0.3);
    }
    .hl-green {
      background: rgba(16, 185, 129, 0.12);
      color: rgb(52, 211, 153);
      font-weight: 700;
      padding: 1px 5px;
      border-bottom: 1px solid rgba(16, 185, 129, 0.3);
    }

    /* ─── Flow diagram ─────────────────────────── */
    .flow-box {
      background: rgba(21, 31, 50, 0.5);
      border: 1px solid rgba(34, 211, 238, 0.2);
      padding: 16px; text-align: center;
    }
    .flow-box-accent {
      background: rgba(34, 211, 238, 0.08);
      border: 1px solid rgba(34, 211, 238, 0.35);
      padding: 16px; text-align: center;
    }
    .flow-arrow {
      color: rgb(34, 211, 238); font-size: 1.5rem;
      display: flex; align-items: center; justify-content: center;
    }

    /* ─── Lesson cards ─────────────────────────── */
    .lesson-card {
      background: rgba(21, 31, 50, 0.4);
      border-left: 3px solid rgb(34, 211, 238);
      padding: 14px 16px; margin-bottom: 12px;
    }
    .lesson-num { font-size: 0.7rem; font-family: monospace; color: rgb(34, 211, 238); font-weight: 700; margin-bottom: 4px; }
    .lesson-title { font-size: 0.95rem; font-weight: 700; color: white; margin-bottom: 4px; }
    .lesson-body { font-size: 0.88rem; line-height: 1.6; color: rgb(148 163 184); }

    /* ─── Seesaw ───────────────────────────────── */
    .seesaw-box {
      display: flex; align-items: center; justify-content: center;
      gap: 12px; padding: 20px;
      border: 1px solid rgba(100, 116, 139, 0.3);
      background: rgba(21, 31, 50, 0.3);
    }
    .seesaw-item { text-align: center; flex: 1; }
    .seesaw-arrow { font-size: 2rem; color: rgb(148 163 184); flex-shrink: 0; }
  </style>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- OPENING QUOTE                                          -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section>
    <div class="border-l-4 border-cyan-500 pl-6 py-2">
      <blockquote class="text-2xl md:text-3xl font-bold italic text-cyan-400 leading-snug">
        "Nợ của một người là tài sản của một người khác. Vấn đề không bao giờ là quy mô của khoản nợ — mà là ai đang giữ nó, và bằng đồng tiền nào."
      </blockquote>
      <footer class="mt-3 text-slate-500 text-sm font-mono tracking-wide">
        — Ray Dalio, <em>Principles for Navigating Big Debt Crises</em>, 2018
      </footer>
    </div>
  </section>

  <!-- CONTEXT INTRO -->
  <section>
    <div class="grid md:grid-cols-3 gap-3 mb-6">
      <div class="border border-slate-700/40 bg-slate-900/20 p-4">
        <p class="text-xs font-mono text-slate-500 font-bold uppercase mb-2">Bối Cảnh</p>
        <p class="text-slate-300 text-sm leading-relaxed">Năm 2026, nợ chính phủ toàn cầu vượt <strong class="text-white">$100 nghìn tỷ</strong>. Riêng Mỹ chi nhiều tiền trả lãi hơn cả ngân sách quốc phòng — lần đầu tiên trong lịch sử hiện đại.</p>
      </div>
      <div class="border border-slate-700/40 bg-slate-900/20 p-4">
        <p class="text-xs font-mono text-slate-500 font-bold uppercase mb-2">Nghịch Lý</p>
        <p class="text-slate-300 text-sm leading-relaxed">Nhật nợ <strong class="text-white">250% GDP</strong> mà lãi suất vẫn gần 0. Hy Lạp vỡ nợ ở 130%. Argentina vỡ nợ 9 lần ở mức thấp hơn nhiều. Con số không giải thích được điều này.</p>
      </div>
      <div class="border border-cyan-500/20 bg-cyan-950/10 p-4">
        <p class="text-xs font-mono text-cyan-500 font-bold uppercase mb-2">Bài Này Đi Qua</p>
        <p class="text-slate-300 text-sm leading-relaxed"><span class="popover-wrap"><button class="popover-trigger">Nợ công</button><span class="popover-bubble">Public debt / Sovereign debt — tổng số tiền chính phủ một quốc gia đang nợ, chủ yếu qua phát hành trái phiếu chính phủ. Tích lũy từ nhiều năm chi tiêu vượt thu (thâm hụt ngân sách). Thường đo bằng tỷ lệ % so với GDP.</span></span> thực chất là gì, vì sao nó <span class="hl">không như nợ cá nhân</span>, và 4 mô hình khác nhau: <span class="hl-gold">Mỹ, Nhật, Trung Quốc, Việt Nam</span>.</p>
      </div>
    </div>
  </section>

  <!-- STATS OVERVIEW -->
  <section>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="stat-card">
        <div class="stat-num">$37T</div>
        <div class="stat-label">Nợ công Mỹ (2026)</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">~250%</div>
        <div class="stat-label">Nợ/GDP của Nhật</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">~90%</div>
        <div class="stat-label">Nợ TQ tính cả địa phương</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">~35%</div>
        <div class="stat-label">Nợ/GDP của Việt Nam</div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- PHẦN 01: NỢ CÔNG LÀ GÌ                                  -->
  <!-- ══════════════════════════════════════════════════════ -->
  <div class="h-px w-full bg-slate-800"></div>

  <section>
    <span class="inline-block bg-cyan-500 text-[#0B1221] font-bold uppercase px-4 py-1.5 mb-4 text-sm tracking-wider">Phần 01</span>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 tracking-tight">Nợ Công Không Phải Nợ Thẻ Tín Dụng — Và Đó Là Toàn Bộ Vấn Đề</h2>
    <p class="text-slate-400 text-base md:text-lg mb-8">Hầu hết mọi người hình dung nợ công như một hộ gia đình vay quá nhiều. Phép loại suy đó sai gần như hoàn toàn — và hiểu vì sao nó sai là chìa khóa của cả bài.</p>

    <!-- Deficit vs Debt -->
    <div class="border border-slate-700/40 bg-slate-900/20 p-6 mb-8">
      <p class="text-xs font-mono text-slate-500 font-bold uppercase mb-3">Phân Biệt Trước Đã</p>
      <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-4">Có hai khái niệm thường bị nhầm lẫn. <span class="popover-wrap"><button class="popover-trigger">Thâm hụt ngân sách</button><span class="popover-bubble">Budget deficit — khoản chênh lệch khi chính phủ chi nhiều hơn thu trong MỘT năm. Đây là một "dòng chảy" (flow). Ví dụ: thu 4.000 tỷ, chi 5.000 tỷ → thâm hụt 1.000 tỷ trong năm đó.</span></span> là chênh lệch thu–chi trong <strong class="text-white">một năm</strong>. <span class="popover-wrap"><button class="popover-trigger">Nợ công</button><span class="popover-bubble">Public debt — tổng số nợ TÍCH LŨY qua nhiều năm thâm hụt. Đây là một "khối tồn kho" (stock). Mỗi năm thâm hụt cộng thêm vào khối nợ này. Ngược lại, thặng dư ngân sách sẽ làm khối nợ giảm.</span></span> là tổng tích lũy của <strong class="text-white">tất cả</strong> các năm thâm hụt.</p>
      <div class="grid md:grid-cols-2 gap-3">
        <div class="border border-cyan-500/20 bg-cyan-950/10 p-4">
          <p class="text-sm text-cyan-400 font-bold mb-1">Thâm hụt = Dòng chảy (flow)</p>
          <p class="text-slate-300 text-sm">Đo trong một năm. Như lượng nước chảy vào bồn mỗi phút.</p>
        </div>
        <div class="border border-amber-500/20 bg-amber-950/10 p-4">
          <p class="text-sm text-amber-400 font-bold mb-1">Nợ = Tồn kho (stock)</p>
          <p class="text-slate-300 text-sm">Mức nước hiện có trong bồn. Tổng của mọi dòng chảy từ trước đến nay.</p>
        </div>
      </div>
    </div>

    <!-- The household fallacy -->
    <div class="border-2 border-cyan-500/40 bg-cyan-950/10 p-6 md:p-8 mb-8">
      <p class="text-xs text-cyan-500 font-bold uppercase tracking-widest mb-4">Vì Sao Phép So Sánh Với Hộ Gia Đình Sai</p>
      <p class="text-2xl md:text-3xl font-black text-white leading-tight mb-4">
        Một gia đình phải trả hết nợ trước khi chết. Một quốc gia thì không bao giờ chết.
      </p>
      <p class="text-base text-slate-300 leading-relaxed mb-3">Chính phủ có thể <span class="popover-wrap"><button class="popover-trigger">đảo nợ</button><span class="popover-bubble">Rollover — khi trái phiếu cũ đáo hạn, chính phủ phát hành trái phiếu mới để lấy tiền trả khoản cũ. Vì quốc gia "sống mãi", nó không cần trả hết nợ — chỉ cần liên tục đảo nợ. Đây là điều một hộ gia đình không làm được.</span></span> vô thời hạn: nợ cũ đáo hạn thì phát hành nợ mới để trả. Quan trọng không phải trả hết — mà là <strong class="text-white">khả năng tiếp tục vay với chi phí chịu được</strong>.</p>
      <p class="text-base text-slate-300 leading-relaxed">Thêm nữa, một số chính phủ in được chính đồng tiền họ vay. Một gia đình không thể tự in tiền trả nợ. Khác biệt này quyết định tất cả.</p>
    </div>

    <!-- The three questions that matter -->
    <p class="text-xs font-mono text-slate-500 font-bold uppercase mb-3 mt-6">Ba Câu Hỏi Quyết Định Một Khoản Nợ Công Có Nguy Hiểm Hay Không</p>
    <div class="grid md:grid-cols-3 gap-4 mb-8">
      <div class="border border-cyan-500/30 bg-cyan-950/10 p-5">
        <p class="text-xs font-mono text-cyan-400 font-bold uppercase mb-2">Câu Hỏi #1</p>
        <h3 class="text-lg font-bold text-white mb-3">Nợ bằng đồng tiền nào?</h3>
        <p class="text-base text-slate-300 leading-relaxed">Nợ bằng <strong class="text-white">nội tệ</strong> (đồng tiền mình in được) thì gần như không bao giờ vỡ nợ kỹ thuật. Nợ bằng <strong class="text-white">ngoại tệ</strong> (USD) thì phải kiếm USD thật để trả — và đó là cái bẫy giết Argentina, Sri Lanka.</p>
      </div>
      <div class="border border-amber-500/30 bg-amber-950/10 p-5">
        <p class="text-xs font-mono text-amber-400 font-bold uppercase mb-2">Câu Hỏi #2</p>
        <h3 class="text-lg font-bold text-white mb-3">Ai đang giữ nợ?</h3>
        <p class="text-base text-slate-300 leading-relaxed">Nợ <strong class="text-white">trong nước</strong> (dân, ngân hàng, BHXH nắm) thì tiền lãi chảy về trong nước. Nợ <strong class="text-white">nước ngoài</strong> nắm giữ thì mỗi đồng lãi là một đồng chảy ra ngoài — và chủ nợ ngoại có thể bỏ chạy bất cứ lúc nào.</p>
      </div>
      <div class="border border-emerald-500/30 bg-emerald-950/10 p-5">
        <p class="text-xs font-mono text-emerald-400 font-bold uppercase mb-2">Câu Hỏi #3</p>
        <h3 class="text-lg font-bold text-white mb-3">Lãi suất so với tăng trưởng?</h3>
        <p class="text-base text-slate-300 leading-relaxed">Nếu nền kinh tế tăng trưởng nhanh hơn lãi suất phải trả (<span class="popover-wrap"><button class="popover-trigger">g &gt; r</button><span class="popover-bubble">g = tốc độ tăng trưởng GDP danh nghĩa, r = lãi suất thực tế trên nợ. Khi g > r, tỷ lệ nợ/GDP tự giảm theo thời gian dù không trả bớt nợ — vì "chiếc bánh" GDP phình ra nhanh hơn khối nợ. Đây là cốt lõi của "động lực nợ bền vững".</span></span>), thì tỷ lệ nợ/GDP <strong class="text-white">tự giảm</strong> theo thời gian. Nếu lãi suất vượt tăng trưởng, nợ phình ra như quả cầu tuyết.</p>
      </div>
    </div>

    <!-- Debt service concept -->
    <div class="lesson-card">
      <div class="lesson-num">KHÁI NIỆM THEN CHỐT</div>
      <div class="lesson-title"><span class="popover-wrap"><button class="popover-trigger">Debt service</button><span class="popover-bubble">Chi phí trả nợ (nghĩa vụ trả nợ) — số tiền lãi (và gốc đến hạn) chính phủ phải trả mỗi năm. Khi nợ lớn VÀ lãi suất tăng, debt service có thể nuốt phần lớn ngân sách, đẩy chính phủ vào vòng xoáy phải vay thêm chỉ để trả lãi.</span></span> — Thứ thực sự giết một quốc gia</div>
      <div class="lesson-body">Không phải con số nợ tuyệt đối làm sụp đổ một chính phủ, mà là khoản lãi phải trả mỗi năm. Khi tiền trả lãi nuốt hết ngân sách giáo dục, y tế, hạ tầng — đó là lúc khủng hoảng bắt đầu, dù tỷ lệ nợ/GDP chưa "kịch trần".</div>
    </div>

    <!-- Mechanics flow -->
    <div class="grid grid-cols-1 md:grid-cols-7 gap-3 items-center mb-8 mt-6">
      <div class="flow-box-accent">
        <p class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-1">Bước 1</p>
        <p class="text-base font-bold text-white">Chi &gt; Thu → Thâm hụt</p>
      </div>
      <div class="flow-arrow hidden md:flex">&rarr;</div>
      <div class="flow-box-accent">
        <p class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-1">Bước 2</p>
        <p class="text-base font-bold text-white">Phát hành trái phiếu</p>
      </div>
      <div class="flow-arrow hidden md:flex">&rarr;</div>
      <div class="flow-box" style="border-color: rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.06);">
        <p class="text-xs font-mono text-amber-400 uppercase tracking-wider mb-1">Bước 3</p>
        <p class="text-base font-bold text-white">Trả lãi định kỳ</p>
      </div>
      <div class="flow-arrow hidden md:flex">&rarr;</div>
      <div class="flow-box" style="border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.06);">
        <p class="text-xs font-mono text-rose-400 uppercase tracking-wider mb-1">Bước 4</p>
        <p class="text-base font-bold text-white">Đáo hạn → Đảo nợ</p>
      </div>
    </div>

    <div class="expand-block">
      <details>
        <summary>
          <svg class="chevron w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          Đào sâu: Vậy "in tiền trả nợ" có giải quyết được mọi thứ không?
        </summary>
        <div class="expand-content">
          <p class="mb-2">Không. In tiền (<span class="popover-wrap"><button class="popover-trigger">tiền tệ hóa nợ</button><span class="popover-bubble">Debt monetization — khi ngân hàng trung ương in tiền mua trái phiếu chính phủ, thực chất tài trợ trực tiếp cho chi tiêu chính phủ. Hệ quả: cung tiền tăng vọt, dễ dẫn đến lạm phát cao nếu làm quá mức.</span></span>) chỉ đổi một loại khủng hoảng lấy loại khác. Bạn tránh được vỡ nợ danh nghĩa, nhưng đẩy rủi ro sang <strong>lạm phát</strong> và <strong>mất giá đồng tiền</strong>.</p>
          <p class="mb-2">Đức Weimar 1923, Zimbabwe 2008, Venezuela 2018 đều "trả được nợ" bằng cách in tiền — và tất cả đều kết thúc bằng siêu lạm phát phá hủy tiết kiệm của cả dân tộc.</p>
          <p>Nói cách khác: một quốc gia in được đồng tiền của mình không vỡ nợ vì <em>không có khả năng trả</em>, mà nó có thể vỡ nợ vì <em>không muốn chấp nhận lạm phát cần thiết để trả</em>. Đó là lựa chọn chính trị, không phải toán học.</p>
        </div>
      </details>
    </div>
  </section>

