      font-size: 0.7rem; color: rgb(148 163 184);
      border-top: 1px dashed rgba(56, 189, 248, 0.2);
      padding-top: 10px;
    }
    .algo-card .ac-meta strong { color: rgb(125 211 252); margin-right: 4px; }

    /* ─── Topology grid ASCII-ish ──────────────── */
    .topology {
      font-family: var(--font-mono);
