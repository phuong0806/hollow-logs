    .lvl-card.l7 ul li::before { color: rgb(251, 191, 36); }
    @media (max-width: 768px) { .lvl-split { grid-template-columns: 1fr; } }

    /* ─── Hash ring viz ────────────────────────── */
    .ring-grid {
      display: grid; grid-template-columns: repeat(12, 1fr);
