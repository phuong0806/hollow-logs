---
import BlueprintLayout from '../../layouts/BlueprintLayout.astro';

export const metadata = {
  title: 'Load Balancer Đào Sâu — Cách Backend Engineer Chia Tải Cho Hệ Thống Sống Sót',
  description: 'Một bài đào sâu về Load Balancer cho Backend Engineer: từ DNS round-robin 1989 đến Maglev của Google và Envoy service mesh. Hiểu Layer 4 vs Layer 7, 8 thuật toán phân phối, health check, sticky session, anycast và direct-server-return — đủ để debug khi production "tự dưng 502" thay vì restart và khấn vái.',
  pubDate: new Date('2026-05-02T14:00:00Z'),
  tags: ['backend', 'networking'],
  theme: 'blueprint',
  draft: false,
};
---

<BlueprintLayout
  title={metadata.title}
  description={metadata.description}
  pubDate={metadata.pubDate}
  tags={metadata.tags}
  kicker="BACKEND // FUNDAMENTALS // LOAD-BALANCER"
  specId="DEEPDIVE // 0005 // LB"
  duration="~55 min read"
>
  <style>
    /* ─── Popovers ─────────────────────────────── */
