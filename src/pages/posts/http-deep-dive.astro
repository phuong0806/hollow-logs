---
import BlueprintLayout from '../../layouts/BlueprintLayout.astro';

export const metadata = {
  title: 'HTTP Đào Sâu — Giao Thức Của Web Mà Backend Engineer Phải Hiểu Đến Tận Bit',
  description: 'Một bài đào sâu về HTTP cho Backend Engineer: từ HTTP/0.9 một dòng năm 1991 đến HTTP/3 trên QUIC năm 2022. Xem từng byte của request/response, hiểu vì sao HTTP/1.1 head-of-line blocking giết hiệu năng, vì sao HTTP/2 chưa đủ, và vì sao Cache-Control không phải mê tín — mà là khoa học.',
  pubDate: new Date('2026-05-02T12:00:00Z'),
  tags: ['backend', 'networking'],
  theme: 'blueprint',
  draft: false,
};
---

<BlueprintLayout
  title={metadata.title}
  description={metadata.description}
  pubDate={metadata.pubDate}
  tags={metadata.tags}
  kicker="BACKEND // FUNDAMENTALS // HTTP"
  specId="DEEPDIVE // 0003 // HTTP"
  duration="~65 min read"
>
  <style>
    /* ─── Popovers ─────────────────────────────── */
    .popover-wrap { position: relative; display: inline; }
    .popover-trigger {
      color: rgb(56, 189, 248);
      border-bottom: 1px dashed rgba(56, 189, 248, 0.45);
      cursor: help; background: none;
      border-top: none; border-left: none; border-right: none;
      font: inherit; padding: 0;
    }
    .popover-trigger:hover { border-bottom-color: rgb(56, 189, 248); }
    .popover-bubble {
      display: none; position: absolute;
      bottom: calc(100% + 8px); left: 50%;
      transform: translateX(-50%); width: 320px;
      padding: 12px 14px; background: #0d1f3a;
      border: 1px solid rgba(56, 189, 248, 0.35);
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
      font-size: 0.82rem; line-height: 1.55;
      color: rgb(203 213 225); z-index: 50; text-align: left;
    }
    .popover-bubble::after {
      content: ''; position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 6px solid transparent;
      border-top-color: rgba(56, 189, 248, 0.35);
    }
    .popover-bubble.show { display: block; }
    @media (max-width: 640px) {
      .popover-bubble { width: 250px; left: 0; transform: none; }
      .popover-bubble::after { left: 20px; transform: none; }
    }

    /* ─── Expand block ─────────────────────────── */
    .expand-block {
      border: 1px solid rgba(56, 189, 248, 0.2);
      background: rgba(13, 31, 58, 0.35); margin: 1rem 0;
    }
    .expand-block summary {
      cursor: pointer; padding: 12px 16px;
      font-family: var(--font-mono);
      font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: rgb(125 211 252);
      display: flex; align-items: center; gap: 8px;
      list-style: none; user-select: none; transition: color 0.2s;
    }
    .expand-block summary::-webkit-details-marker { display: none; }
    .expand-block summary:hover { color: rgb(186 230 253); }
    .expand-block summary .chevron { transition: transform 0.25s; flex-shrink: 0; }
    .expand-block[open] summary .chevron { transform: rotate(90deg); }
    .expand-block .expand-content {
      padding: 4px 16px 16px;
      font-size: 0.92rem; line-height: 1.7; color: rgb(203 213 225);
    }

    /* ─── Stat cards ───────────────────────────── */
    .stat-card {
      background: rgba(13, 31, 58, 0.5);
      border: 1px solid rgba(56, 189, 248, 0.2);
      padding: 18px; text-align: center;
    }
    .stat-num {
      font-family: var(--font-space-mono);
      font-size: 1.85rem; font-weight: 700; color: rgb(56, 189, 248);
      line-height: 1; margin-bottom: 6px;
    }
    .stat-label {
      font-size: 0.72rem; color: rgb(100 116 139);
      text-transform: uppercase; letter-spacing: 0.08em;
    }

    /* ─── Inline highlights ────────────────────── */
    .hl { background: rgba(56, 189, 248, 0.12); color: rgb(125 211 252); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(56, 189, 248, 0.4); }
    .hl-gold { background: rgba(251, 191, 36, 0.12); color: rgb(251, 191, 36); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(251, 191, 36, 0.35); }
    .hl-red { background: rgba(239, 68, 68, 0.12); color: rgb(252, 165, 165); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(239, 68, 68, 0.3); }
    .hl-green { background: rgba(16, 185, 129, 0.12); color: rgb(110 231 183); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(16, 185, 129, 0.3); }
    .hl-purple { background: rgba(168, 85, 247, 0.12); color: rgb(216 180 254); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(168, 85, 247, 0.35); }

    /* ─── Section heading ─────────────────────── */
    .section-num {
      display: inline-block;
      background: rgb(56, 189, 248);
      color: #06101e;
      font-family: var(--font-mono);
      font-size: 0.8rem; font-weight: 700;
      padding: 4px 12px;
      letter-spacing: 0.12em;
      margin-bottom: 12px;
    }

    /* ─── Wire view (raw HTTP dump) ──────────── */
    .wire {
      background: #020817;
      border: 1px solid rgba(56, 189, 248, 0.35);
      box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.05) inset;
      padding: 16px 18px;
      margin: 1rem 0;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      line-height: 1.65;
      color: rgb(186 230 253);
      overflow-x: auto;
      white-space: pre;
    }
    .wire .w-method { color: rgb(251, 191, 36); font-weight: 700; }
    .wire .w-path { color: rgb(110, 231, 183); }
    .wire .w-status { color: rgb(56, 189, 248); font-weight: 700; }
    .wire .w-header { color: rgb(216, 180, 254); }
    .wire .w-value { color: rgb(203, 213, 225); }
    .wire .w-comment { color: rgb(100, 116, 139); font-style: italic; }
    .wire .w-body { color: rgb(252, 211, 77); }
    .wire .w-frame { color: rgb(244, 114, 182); font-weight: 700; }

    /* ─── Timeline (history) ──────────────────── */
    .history-line { position: relative; padding-left: 28px; margin: 1.5rem 0; }
    .history-line::before {
      content: ''; position: absolute; left: 8px; top: 8px; bottom: 8px;
      width: 1px; background: rgba(56, 189, 248, 0.35);
    }
    .h-event { position: relative; padding-bottom: 22px; }
    .h-event::before {
      content: ''; position: absolute; left: -24px; top: 6px;
      width: 9px; height: 9px;
      background: #06101e;
      border: 2px solid rgb(56, 189, 248);
      border-radius: 50%;
    }
    .h-event .h-year {
      font-family: var(--font-mono);
      font-size: 0.72rem; font-weight: 700;
      color: rgb(56, 189, 248);
      letter-spacing: 0.1em; margin-bottom: 4px;
    }
    .h-event .h-title {
      font-size: 1.05rem; font-weight: 700; color: white; margin-bottom: 4px;
    }
    .h-event .h-body {
      font-size: 0.9rem; color: rgb(203 213 225); line-height: 1.6;
    }

    /* ─── Method card grid ────────────────────── */
    .method-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px; margin: 1.5rem 0;
    }
    .method-card {
      border: 1px solid rgba(56, 189, 248, 0.25);
      background: rgba(13, 31, 58, 0.4);
      padding: 14px 16px;
      transition: border-color 0.2s, transform 0.2s;
    }
    .method-card:hover {
      border-color: rgba(56, 189, 248, 0.6);
      transform: translateY(-2px);
    }
    .method-card .m-name {
      font-family: var(--font-mono);
      font-size: 1.1rem; font-weight: 700;
      color: white; letter-spacing: 0.05em;
      margin-bottom: 4px;
    }
    .method-card .m-tags {
      display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 8px;
    }
    .method-card .m-tag {
      font-family: var(--font-mono);
      font-size: 0.6rem; padding: 1px 6px;
      letter-spacing: 0.08em; text-transform: uppercase;
    }
    .m-tag.safe { background: rgba(16, 185, 129, 0.15); color: rgb(110 231 183); }
    .m-tag.idem { background: rgba(56, 189, 248, 0.15); color: rgb(125 211 252); }
    .m-tag.cache { background: rgba(251, 191, 36, 0.15); color: rgb(251 191 36); }
    .m-tag.unsafe { background: rgba(239, 68, 68, 0.15); color: rgb(252 165 165); }
    .method-card .m-desc {
      font-size: 0.8rem; color: rgb(203 213 225); line-height: 1.55;
    }

    /* ─── Status code constellation ───────────── */
    .status-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 6px; margin: 1.5rem 0;
    }
    .status-card {
      border: 1px solid;
      padding: 12px 14px;
      background: rgba(13, 31, 58, 0.4);
    }
    .status-card .s-code {
      font-family: var(--font-space-mono);
      font-size: 1.4rem; font-weight: 700;
      line-height: 1; margin-bottom: 4px;
    }
    .status-card .s-name {
      font-size: 0.85rem; color: white; font-weight: 700;
      margin-bottom: 4px;
    }
    .status-card .s-desc {
      font-size: 0.78rem; color: rgb(148 163 184); line-height: 1.5;
    }
    .status-card.s-1xx { border-color: rgba(168, 85, 247, 0.4); }
    .status-card.s-1xx .s-code { color: rgb(216, 180, 254); }
    .status-card.s-2xx { border-color: rgba(16, 185, 129, 0.4); }
    .status-card.s-2xx .s-code { color: rgb(110, 231, 183); }
    .status-card.s-3xx { border-color: rgba(56, 189, 248, 0.4); }
    .status-card.s-3xx .s-code { color: rgb(125, 211, 252); }
    .status-card.s-4xx { border-color: rgba(251, 191, 36, 0.4); }
    .status-card.s-4xx .s-code { color: rgb(252, 211, 77); }
    .status-card.s-5xx { border-color: rgba(239, 68, 68, 0.4); }
    .status-card.s-5xx .s-code { color: rgb(252, 165, 165); }

    /* ─── Status class spectrum ────────────────── */
    .status-spectrum {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 4px; margin: 1.5rem 0;
    }
    .status-band {
      padding: 16px 14px;
      border: 1px solid;
      background: rgba(13, 31, 58, 0.4);
    }
    .status-band .sb-class {
      font-family: var(--font-space-mono);
      font-size: 1.6rem; font-weight: 700;
      line-height: 1; margin-bottom: 6px;
    }
    .status-band .sb-name {
      font-family: var(--font-mono);
      font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: white; margin-bottom: 6px;
    }
    .status-band .sb-desc {
      font-size: 0.78rem; color: rgb(203 213 225); line-height: 1.5;
    }
    .status-band.s-1xx { border-color: rgba(168, 85, 247, 0.5); }
    .status-band.s-1xx .sb-class { color: rgb(216, 180, 254); }
    .status-band.s-2xx { border-color: rgba(16, 185, 129, 0.5); }
    .status-band.s-2xx .sb-class { color: rgb(110, 231, 183); }
    .status-band.s-3xx { border-color: rgba(56, 189, 248, 0.5); }
    .status-band.s-3xx .sb-class { color: rgb(125, 211, 252); }
    .status-band.s-4xx { border-color: rgba(251, 191, 36, 0.5); }
    .status-band.s-4xx .sb-class { color: rgb(252, 211, 77); }
    .status-band.s-5xx { border-color: rgba(239, 68, 68, 0.5); }
    .status-band.s-5xx .sb-class { color: rgb(252, 165, 165); }
    @media (max-width: 768px) {
      .status-spectrum { grid-template-columns: 1fr 1fr; }
    }

    /* ─── Header anatomy ───────────────────────── */
    .header-row {
      display: grid;
      grid-template-columns: 220px 100px 1fr;
      gap: 0;
      border: 1px solid rgba(56, 189, 248, 0.2);
      background: rgba(13, 31, 58, 0.3);
      margin-bottom: 4px;
    }
    .header-row:hover { background: rgba(13, 31, 58, 0.55); border-color: rgba(56, 189, 248, 0.45); }
    .header-row .hr-name {
      padding: 12px 14px;
      font-family: var(--font-mono);
      font-size: 0.85rem; color: rgb(186 230 253);
      font-weight: 600;
      border-right: 1px solid rgba(56, 189, 248, 0.15);
    }
    .header-row .hr-dir {
      padding: 12px 14px;
      font-family: var(--font-mono);
      font-size: 0.7rem; letter-spacing: 0.1em;
      color: rgb(251, 191, 36);
      border-right: 1px solid rgba(56, 189, 248, 0.15);
      display: flex; align-items: center;
    }
    .header-row .hr-desc {
      padding: 12px 14px;
      font-size: 0.85rem; color: rgb(203 213 225);
      line-height: 1.55;
    }
    @media (max-width: 768px) {
      .header-row { grid-template-columns: 1fr; }
      .header-row .hr-name { border-right: none; border-bottom: 1px dashed rgba(56, 189, 248, 0.2); }
      .header-row .hr-dir { border-right: none; }
    }

    /* ─── HTTP version evolution ──────────────── */
    .version-line {
      display: grid;
      grid-template-columns: 90px 1fr 1fr 1fr;
      gap: 0;
      border: 1px solid rgba(56, 189, 248, 0.25);
      margin-bottom: 4px;
      background: rgba(13, 31, 58, 0.4);
    }
    .version-line .v-id {
      padding: 14px 12px;
      background: rgba(56, 189, 248, 0.12);
      font-family: var(--font-space-mono);
      font-size: 1.05rem; font-weight: 700;
      color: rgb(125, 211, 252);
      border-right: 1px solid rgba(56, 189, 248, 0.25);
      display: flex; flex-direction: column; justify-content: center;
    }
    .version-line .v-id span {
      font-family: var(--font-mono);
      font-size: 0.65rem; color: rgb(148, 163, 184);
      letter-spacing: 0.08em; margin-top: 2px;
    }
    .version-line .v-cell {
      padding: 14px 14px;
      font-size: 0.82rem; color: rgb(203 213 225);
      line-height: 1.5;
      border-right: 1px solid rgba(56, 189, 248, 0.15);
    }
    .version-line .v-cell:last-child { border-right: none; }
    .version-line .v-cell strong { color: white; font-weight: 700; }
    @media (max-width: 768px) {
      .version-line { grid-template-columns: 80px 1fr; }
      .version-line .v-cell { border-right: none; border-top: 1px dashed rgba(56, 189, 248, 0.15); }
    }

    /* ─── Comparison table ─────────────────────── */
    .compare-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
    .compare-table th {
      padding: 10px 12px; background: rgba(13, 31, 58, 0.7);
      color: rgb(148 163 184); font-weight: 700; text-align: left;
      border-bottom: 1px solid rgba(56, 189, 248, 0.3);
      font-family: var(--font-mono);
      font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
    }
    .compare-table td {
      padding: 10px 12px; border-bottom: 1px solid rgba(100,116,139,0.15);
      color: rgb(203 213 225); vertical-align: top;
    }
    .compare-table tr:last-child td { border-bottom: none; }
    .compare-table tr:hover td { background: rgba(56, 189, 248, 0.04); }
    .compare-table .col-metric { color: white; font-weight: 600; }
    .compare-table .good { color: rgb(110, 231, 183); }
    .compare-table .bad { color: rgb(252, 165, 165); }
    .compare-table .neutral { color: rgb(251, 191, 36); }

    /* ─── Pitfall block ────────────────────────── */
    .pitfall {
      background: rgba(239, 68, 68, 0.06);
      border-left: 3px solid rgb(239, 68, 68);
      padding: 14px 16px; margin-bottom: 12px;
    }
    .pitfall .pf-num {
      font-family: var(--font-mono);
      font-size: 0.7rem; font-weight: 700;
      color: rgb(252, 165, 165);
      letter-spacing: 0.1em; text-transform: uppercase;
      margin-bottom: 4px;
    }
    .pitfall .pf-title {
      font-size: 0.95rem; font-weight: 700; color: white; margin-bottom: 4px;
    }
    .pitfall .pf-body {
      font-size: 0.86rem; color: rgb(203 213 225); line-height: 1.6;
    }

    /* ─── Latency / size bar ───────────────────── */
    .lat-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
    .lat-name { font-size: 0.85rem; color: rgb(203 213 225); width: 220px; flex-shrink: 0; font-family: var(--font-mono); }
    .lat-track { flex: 1; height: 24px; background: rgba(13, 31, 58, 0.5); border: 1px solid rgba(56, 189, 248, 0.15); }
    .lat-fill {
      height: 100%; display: flex; align-items: center; padding-left: 8px;
      font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: #06101e;
    }
    @media (max-width: 640px) {
      .lat-name { width: 130px; font-size: 0.72rem; }
    }

    /* ─── Connection diagrams (HTTP/1.1 vs /2 vs /3) ── */
    .conn-diagram {
      border: 1px solid rgba(56, 189, 248, 0.25);
      background: rgba(13, 31, 58, 0.35);
      padding: 14px 16px;
      margin-bottom: 10px;
    }
    .conn-diagram .cd-title {
      font-family: var(--font-mono);
      font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: rgb(125, 211, 252);
      margin-bottom: 10px;
    }
    .conn-diagram .cd-stream {
      display: flex; align-items: center; gap: 6px;
      margin-bottom: 4px; font-family: var(--font-mono); font-size: 0.72rem;
    }
    .conn-diagram .cd-label {
      width: 80px; flex-shrink: 0; color: rgb(148, 163, 184);
    }
    .conn-diagram .cd-track {
      flex: 1; display: flex; gap: 2px;
    }
    .conn-diagram .cd-block {
      height: 18px; min-width: 22px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.6rem; font-weight: 700; color: #06101e;
    }
    .cd-r1 { background: rgb(56, 189, 248); }
    .cd-r2 { background: rgb(251, 191, 36); }
    .cd-r3 { background: rgb(110, 231, 183); }
    .cd-r4 { background: rgb(244, 114, 182); }
    .cd-blocked { background: rgba(239, 68, 68, 0.4); color: white; }
    .cd-idle { background: rgba(100, 116, 139, 0.25); color: rgb(148, 163, 184); }

    /* ─── Cache decision flow ─────────────────── */
    .cache-flow {
      display: grid; grid-template-columns: 56px 1fr; gap: 14px;
      margin-bottom: 10px;
      border-left: 2px solid rgba(56, 189, 248, 0.4);
      padding: 10px 12px;
      background: rgba(13, 31, 58, 0.4);
    }
    .cache-flow .cf-num {
      font-family: var(--font-space-mono);
      font-size: 1.4rem; font-weight: 700; color: rgb(56, 189, 248);
      line-height: 1; align-self: center;
    }
    .cache-flow .cf-title {
      font-size: 0.95rem; font-weight: 700; color: white; margin-bottom: 4px;
    }
    .cache-flow .cf-body {
      font-size: 0.85rem; color: rgb(203 213 225); line-height: 1.55;
    }

    /* ─── CTA / lab callout ─────────────────── */
    .lab-card {
      background: rgba(251, 191, 36, 0.06);
      border: 1px dashed rgba(251, 191, 36, 0.4);
      padding: 16px 18px; margin: 1rem 0;
    }
    .lab-card .lc-label {
      font-family: var(--font-mono);
      font-size: 0.7rem; font-weight: 700;
      color: rgb(251, 191, 36);
      letter-spacing: 0.12em; text-transform: uppercase;
      margin-bottom: 8px;
    }
    .lab-card .lc-title {
      font-size: 1.05rem; font-weight: 700; color: white; margin-bottom: 6px;
    }
    .lab-card .lc-body { font-size: 0.9rem; color: rgb(254 243 199); line-height: 1.65; }
  </style>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- OPENING QUOTE                                           -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section>
    <div class="border-l-4 border-cyan-400 pl-6 py-2">
      <blockquote class="text-2xl md:text-3xl font-bold italic text-cyan-300 leading-snug">
        "Web không thực sự là một thứ — nó là một thoả thuận về cách các thứ nói chuyện với nhau. HTTP là cuộc đối thoại đó."
      </blockquote>
      <footer class="mt-3 text-slate-500 text-sm font-mono tracking-wide">
        — Tim Berners-Lee, lời giới thiệu World Wide Web (CERN, 12-1990)
      </footer>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- INTRO CONTEXT                                           -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section>
    <div class="grid md:grid-cols-3 gap-3 mb-6">
      <div class="border border-cyan-900/40 bg-slate-950/40 p-4">
        <p class="text-xs font-mono text-cyan-500/70 font-bold uppercase mb-2 tracking-wider">Bối Cảnh</p>
        <p class="text-slate-300 text-sm leading-relaxed">HTTP là <span class="hl">giao thức ứng dụng phổ biến nhất hành tinh</span>. Mỗi click trình duyệt, mỗi gọi API, mỗi push notification — đều là một dòng <code class="bg-slate-900/60 px-1.5 py-0.5 text-cyan-300 text-xs">GET /</code> hay <code class="bg-slate-900/60 px-1.5 py-0.5 text-cyan-300 text-xs">POST /api</code>.</p>
      </div>
      <div class="border border-cyan-900/40 bg-slate-950/40 p-4">
        <p class="text-xs font-mono text-cyan-500/70 font-bold uppercase mb-2 tracking-wider">Vấn Đề</p>
        <p class="text-slate-300 text-sm leading-relaxed">Backend Engineer copy-paste <code class="bg-slate-900/60 px-1.5 py-0.5 text-cyan-300 text-xs">return res.json(&#123;...&#125;)</code> hàng nghìn lần mà không biết byte nào ra dây. Đến khi <span class="hl-red">CORS chặn, cache stale, redirect loop</span> — chỉ còn cách Google.</p>
      </div>
      <div class="border border-amber-500/30 bg-amber-950/10 p-4">
        <p class="text-xs font-mono text-amber-400 font-bold uppercase mb-2 tracking-wider">Bài Này Đi Qua</p>
        <p class="text-slate-300 text-sm leading-relaxed">35 năm tiến hoá HTTP/0.9 → 3.0, anatomy của request/response đến tận từng byte, methods, status codes, headers, caching, cookies, CORS, và những vụ "HTTP sập production" lịch sử.</p>
      </div>
    </div>

    <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-4">Tim Berners-Lee phát minh HTTP năm 1989 ở <span class="popover-wrap"><button class="popover-trigger">CERN</button><span class="popover-bubble">CERN — Tổ chức Nghiên cứu Hạt nhân Châu Âu, đặt tại Geneva. Không phải nơi sinh ra Internet (đó là ARPANET, 1969), mà là nơi sinh ra World Wide Web — một ứng dụng <em>chạy trên</em> Internet. Berners-Lee viết HTTP, HTML, URL, và browser đầu tiên cùng nhau cuối 1990.</span></span> để chia sẻ tài liệu giữa các nhà vật lý. Phiên bản đầu — HTTP/0.9 — chỉ có một câu lệnh duy nhất: <code class="bg-slate-900/60 px-1.5 py-0.5 text-cyan-300 text-sm">GET /index.html</code>. Không header, không status code, không version. Trả về HTML thô và đóng kết nối.</p>

    <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-4">36 năm sau, HTTP/3 chạy trên <span class="popover-wrap"><button class="popover-trigger">QUIC</button><span class="popover-bubble">QUIC — Quick UDP Internet Connections. Giao thức transport do Google phát minh 2012, IETF chuẩn hoá thành RFC 9000 năm 2021. Thay TCP+TLS bằng một protocol duy nhất chạy trên UDP, gộp connection setup và TLS handshake vào 1-RTT (hoặc 0-RTT khi resume), tránh head-of-line blocking ở tầng transport.</span></span> trên UDP, mã hoá toàn phần, multiplexing 1.000 stream song song, không head-of-line blocking. Nhưng <span class="hl-gold">90% lưu lượng ngoài thực địa năm 2026 vẫn là HTTP/1.1 hoặc /2</span>. Bài này dạy bạn đọc cả ba — và biết khi nào nên dùng cái nào.</p>

    <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-4">Mục tiêu: sau khi đọc xong, bạn nhìn vào output của <code class="bg-slate-900/60 px-1.5 py-0.5 text-cyan-300 text-sm">curl -v</code> không còn thấy "ma trận xanh đỏ" — bạn thấy <span class="hl">một bức thư có cấu trúc</span> mà mình hiểu từng dòng.</p>
  </section>

