  <div class="ornament">§</div>

  <section>
    <span class="chapter-num">Chương 12 · TCP và TLS hiện đại</span>
    <h2 class="text-3xl md:text-4xl font-bold mb-4">HTTP/2, HTTP/3, QUIC, mTLS</h2>

    <figure>
      <table class="codex-table">
        <thead>
          <tr>
            <th>Phiên bản</th>
            <th>Năm</th>
            <th>Transport</th>
            <th>Cải tiến chính</th>
