  <script>
    document.querySelectorAll('.pop-trig').forEach((trig) => {
      trig.addEventListener('click', (e) => {
        e.stopPropagation();
        const bub = trig.nextElementSibling;
        document.querySelectorAll('.pop-bub.show').forEach((b) => {
          if (b !== bub) b.classList.remove('show');
        });
        bub?.classList.toggle('show');
      });
    });
    document.addEventListener('click', () => {
      document.querySelectorAll('.pop-bub.show').forEach((b) => b.classList.remove('show'));
    });
  </script>
