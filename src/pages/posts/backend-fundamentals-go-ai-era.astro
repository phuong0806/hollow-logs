---
import BlueprintLayout from '../../layouts/BlueprintLayout.astro';

export const metadata = {
  title: '6 Tháng Học Backend Trong Kỷ Nguyên AI — Lộ Trình Kỹ Sư Cùng Golang',
  description: 'AI viết được code, nhưng không hiểu được hệ thống. Một bản đồ 26 tuần để xây nền móng backend thật — từ DNS, HTTP, trình duyệt đến server Go, database, caching, và LLM agent. Mỗi tuần đều có tài liệu đọc và video kèm theo.',
  pubDate: new Date('2026-05-01'),
  tags: ['programming', 'backend'],
  theme: 'blueprint',
  draft: false,
};
---

<BlueprintLayout
  title={metadata.title}
  description={metadata.description}
  pubDate={metadata.pubDate}
  tags={metadata.tags}
  kicker="BACKEND // FUNDAMENTALS // GO"
  specId="ROADMAP // 0001 // 6-MONTHS"
  duration="26 weeks"
>
  <style>
    /* ─── Popovers ─────────────────────────────── */
    .popover-wrap { position: relative; display: inline; }
    .popover-trigger {
      color: rgb(56, 189, 248);
      border-bottom: 1px dashed rgba(56, 189, 248, 0.45);
      cursor: help; background: none;
      border-top: none; border-left: none; border-right: none;
      font: inherit; padding: 0;
    }
    .popover-trigger:hover { border-bottom-color: rgb(56, 189, 248); }
    .popover-bubble {
      display: none; position: absolute;
      bottom: calc(100% + 8px); left: 50%;
      transform: translateX(-50%); width: 320px;
      padding: 12px 14px; background: #0d1f3a;
      border: 1px solid rgba(56, 189, 248, 0.35);
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
      font-size: 0.82rem; line-height: 1.55;
      color: rgb(203 213 225); z-index: 50; text-align: left;
    }
    .popover-bubble::after {
      content: ''; position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 6px solid transparent;
      border-top-color: rgba(56, 189, 248, 0.35);
    }
    .popover-bubble.show { display: block; }
    @media (max-width: 640px) {
      .popover-bubble { width: 250px; left: 0; transform: none; }
      .popover-bubble::after { left: 20px; transform: none; }
    }

    /* ─── Expand block ─────────────────────────── */
    .expand-block {
      border: 1px solid rgba(56, 189, 248, 0.2);
      background: rgba(13, 31, 58, 0.35); margin: 1rem 0;
    }
    .expand-block summary {
      cursor: pointer; padding: 12px 16px;
      font-family: var(--font-mono);
      font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: rgb(125 211 252);
      display: flex; align-items: center; gap: 8px;
      list-style: none; user-select: none; transition: color 0.2s;
    }
    .expand-block summary::-webkit-details-marker { display: none; }
    .expand-block summary:hover { color: rgb(186 230 253); }
    .expand-block summary .chevron { transition: transform 0.25s; flex-shrink: 0; }
    .expand-block[open] summary .chevron { transform: rotate(90deg); }
    .expand-block .expand-content {
      padding: 4px 16px 16px;
      font-size: 0.92rem; line-height: 1.7; color: rgb(203 213 225);
    }

    /* ─── Stat cards ───────────────────────────── */
    .stat-card {
      background: rgba(13, 31, 58, 0.5);
      border: 1px solid rgba(56, 189, 248, 0.2);
      padding: 18px; text-align: center;
    }
    .stat-num {
      font-family: var(--font-space-mono);
      font-size: 1.85rem; font-weight: 700; color: rgb(56, 189, 248);
      line-height: 1; margin-bottom: 6px;
    }
    .stat-label {
      font-size: 0.72rem; color: rgb(100 116 139);
      text-transform: uppercase; letter-spacing: 0.08em;
    }

    /* ─── Inline highlights ────────────────────── */
    .hl { background: rgba(56, 189, 248, 0.12); color: rgb(125 211 252); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(56, 189, 248, 0.4); }
    .hl-gold { background: rgba(251, 191, 36, 0.12); color: rgb(251, 191, 36); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(251, 191, 36, 0.35); }
    .hl-red { background: rgba(239, 68, 68, 0.12); color: rgb(252, 165, 165); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(239, 68, 68, 0.3); }
    .hl-green { background: rgba(16, 185, 129, 0.12); color: rgb(110 231 183); font-weight: 700; padding: 1px 5px; border-bottom: 1px solid rgba(16, 185, 129, 0.3); }

    /* ─── Module / Month card ──────────────────── */
    .module-card {
      border: 1px solid rgba(56, 189, 248, 0.25);
      background: rgba(13, 31, 58, 0.3);
      margin-top: 1.5rem;
    }
    .module-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 18px;
      border-bottom: 1px solid rgba(56, 189, 248, 0.25);
      background: rgba(13, 31, 58, 0.6);
      font-family: var(--font-mono);
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
    }
    .module-header .m-id { color: rgb(56, 189, 248); font-weight: 700; }
    .module-header .m-time { color: rgb(251, 191, 36); }
    .module-body { padding: 24px 18px; }

    /* ─── Resource list ────────────────────────── */
    .resource {
      display: block;
      padding: 12px 14px;
      margin-bottom: 8px;
      border-left: 2px solid rgba(56, 189, 248, 0.4);
      background: rgba(13, 31, 58, 0.45);
      transition: border-color 0.2s, background 0.2s;
      text-decoration: none;
    }
    .resource:hover {
      border-left-color: rgb(56, 189, 248);
      background: rgba(13, 31, 58, 0.7);
    }
    .resource .r-kind {
      font-family: var(--font-mono);
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.15em; text-transform: uppercase;
      color: rgb(56, 189, 248);
      display: inline-block; margin-right: 8px;
    }
    .resource .r-kind.video { color: rgb(252, 165, 165); }
    .resource .r-kind.book { color: rgb(251, 191, 36); }
    .resource .r-kind.docs { color: rgb(110, 231, 183); }
    .resource .r-kind.tool { color: rgb(196, 181, 253); }
    .resource .r-title {
      font-size: 0.92rem; font-weight: 600; color: white;
      line-height: 1.45;
    }
    .resource .r-desc {
      font-size: 0.82rem; line-height: 1.55;
      color: rgb(148 163 184); margin-top: 4px;
    }
    .resource .r-host {
      font-family: var(--font-mono);
      font-size: 0.7rem; color: rgb(100 116 139);
      margin-top: 4px;
    }

    /* ─── Topic list ───────────────────────────── */
    .topic-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
    .topic-chip {
      font-family: var(--font-mono);
      font-size: 0.72rem; font-weight: 500;
      padding: 4px 10px;
      background: rgba(56, 189, 248, 0.08);
      border: 1px solid rgba(56, 189, 248, 0.25);
      color: rgb(125 211 252);
      letter-spacing: 0.04em;
    }

    /* ─── Project card ─────────────────────────── */
    .project-card {
      background: rgba(251, 191, 36, 0.06);
      border: 1px dashed rgba(251, 191, 36, 0.4);
      padding: 14px 16px;
      margin-top: 18px;
    }
    .project-card .p-label {
      font-family: var(--font-mono);
      font-size: 0.7rem; font-weight: 700;
      color: rgb(251, 191, 36);
      letter-spacing: 0.12em; text-transform: uppercase;
      margin-bottom: 4px;
    }
    .project-card .p-text {
      font-size: 0.92rem; color: rgb(254 243 199); line-height: 1.6;
    }

    /* ─── Timeline / 6-month overview ──────────── */
    .timeline-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 4px; margin: 1.5rem 0;
    }
    .timeline-cell {
      background: rgba(13, 31, 58, 0.4);
      border: 1px solid rgba(56, 189, 248, 0.2);
      padding: 12px 10px; text-align: center;
      font-family: var(--font-mono);
      transition: transform 0.2s, border-color 0.2s;
    }
    .timeline-cell:hover {
      transform: translateY(-3px);
      border-color: rgba(56, 189, 248, 0.6);
    }
    .timeline-cell .tc-num {
      font-size: 0.7rem; color: rgb(56, 189, 248);
      letter-spacing: 0.1em; margin-bottom: 4px;
    }
    .timeline-cell .tc-name {
      font-size: 0.72rem; color: white; font-weight: 700;
      line-height: 1.3;
    }
    @media (max-width: 768px) {
      .timeline-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ─── Architecture flow ───────────────────── */
    .flow-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      gap: 6px;
      align-items: center;
      margin: 1rem 0;
    }
    .flow-node {
      background: rgba(13, 31, 58, 0.6);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 12px 8px; text-align: center;
    }
    .flow-node .fn-label {
      font-family: var(--font-mono);
      font-size: 0.65rem; color: rgb(56, 189, 248);
      letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px;
    }
    .flow-node .fn-name {
      font-size: 0.85rem; color: white; font-weight: 600;
    }
    .flow-arr {
      color: rgb(56, 189, 248); font-size: 1.2rem; font-family: var(--font-mono);
    }
    @media (max-width: 768px) {
      .flow-row { grid-template-columns: 1fr; }
      .flow-arr { transform: rotate(90deg); margin: 4px auto; }
    }

    /* ─── Comparison table ─────────────────────── */
    .compare-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
    .compare-table th {
      padding: 10px 12px; background: rgba(13, 31, 58, 0.7);
      color: rgb(148 163 184); font-weight: 700; text-align: left;
      border-bottom: 1px solid rgba(56, 189, 248, 0.3);
      font-family: var(--font-mono);
      font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
    }
    .compare-table td {
      padding: 10px 12px; border-bottom: 1px solid rgba(100,116,139,0.15);
      color: rgb(203 213 225); vertical-align: top;
    }
    .compare-table tr:last-child td { border-bottom: none; }
    .compare-table tr:hover td { background: rgba(56, 189, 248, 0.04); }
    .compare-table .col-metric { color: white; font-weight: 600; }
    .compare-table .good { color: rgb(110, 231, 183); }
    .compare-table .bad { color: rgb(252, 165, 165); }
    .compare-table .neutral { color: rgb(251, 191, 36); }

    /* ─── Time bar (hours per topic) ──────────── */
    .hour-row {
      display: flex; align-items: center; gap: 12px; margin-bottom: 10px;
    }
    .hour-name {
      font-size: 0.85rem; color: rgb(203 213 225);
      width: 180px; flex-shrink: 0;
    }
    .hour-bar-track {
      flex: 1; height: 22px;
      background: rgba(13, 31, 58, 0.5);
      border: 1px solid rgba(56, 189, 248, 0.15);
    }
    .hour-bar-fill {
      height: 100%;
      display: flex; align-items: center;
      padding-left: 8px;
      font-family: var(--font-mono);
      font-size: 0.7rem; font-weight: 700; color: #06101e;
    }
    @media (max-width: 640px) {
      .hour-name { width: 110px; font-size: 0.75rem; }
    }

    /* ─── Pitfall block ────────────────────────── */
    .pitfall {
      background: rgba(239, 68, 68, 0.06);
      border-left: 3px solid rgb(239, 68, 68);
      padding: 14px 16px; margin-bottom: 12px;
    }
    .pitfall .pf-num {
      font-family: var(--font-mono);
      font-size: 0.7rem; font-weight: 700;
      color: rgb(252, 165, 165);
      letter-spacing: 0.1em; text-transform: uppercase;
      margin-bottom: 4px;
    }
    .pitfall .pf-title {
      font-size: 0.95rem; font-weight: 700; color: white; margin-bottom: 4px;
    }
    .pitfall .pf-body {
      font-size: 0.86rem; color: rgb(203 213 225); line-height: 1.6;
    }

    /* ─── Section heading ─────────────────────── */
    .section-num {
      display: inline-block;
      background: rgb(56, 189, 248);
      color: #06101e;
      font-family: var(--font-mono);
      font-size: 0.8rem; font-weight: 700;
      padding: 4px 12px;
      letter-spacing: 0.12em;
      margin-bottom: 12px;
    }
  </style>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- OPENING QUOTE                                          -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section>
    <div class="border-l-4 border-cyan-400 pl-6 py-2">
      <blockquote class="text-2xl md:text-3xl font-bold italic text-cyan-300 leading-snug">
        "Khoa học máy tính không nói về máy tính, cũng giống như thiên văn học không nói về kính viễn vọng."
      </blockquote>
      <footer class="mt-3 text-slate-500 text-sm font-mono tracking-wide">
        — Edsger W. Dijkstra (1986)
      </footer>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- INTRO CONTEXT                                          -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section>
    <div class="grid md:grid-cols-3 gap-3 mb-6">
      <div class="border border-cyan-900/40 bg-slate-950/40 p-4">
        <p class="text-xs font-mono text-cyan-500/70 font-bold uppercase mb-2 tracking-wider">Bối Cảnh</p>
        <p class="text-slate-300 text-sm leading-relaxed">2026 — <strong class="text-white">Claude</strong>, <strong class="text-white">GPT-5</strong>, <strong class="text-white">Gemini</strong> viết được CRUD trong 30 giây. Nhưng khi production sập lúc 3 giờ sáng, không AI nào tự debug được race condition trong goroutine của bạn.</p>
      </div>
      <div class="border border-cyan-900/40 bg-slate-950/40 p-4">
        <p class="text-xs font-mono text-cyan-500/70 font-bold uppercase mb-2 tracking-wider">Vấn Đề</p>
        <p class="text-slate-300 text-sm leading-relaxed">Người mới học backend đang bỏ qua nền móng — DNS, TCP, HTTP, hệ điều hành — vì AI "tự lo" được. Kết quả: <span class="hl-red">không hiểu code mình copy</span>, không debug được hệ thống thật.</p>
      </div>
      <div class="border border-amber-500/30 bg-amber-950/10 p-4">
        <p class="text-xs font-mono text-amber-400 font-bold uppercase mb-2 tracking-wider">Bài Này Đi Qua</p>
        <p class="text-slate-300 text-sm leading-relaxed">26 tuần học backend từ nền móng đến triển khai, dùng Go làm ngôn ngữ chính. Mỗi module có <span class="hl">tài liệu đọc + video</span> được kiểm chứng.</p>
      </div>
    </div>

    <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-4">Năm 1968, hội nghị NATO ở Garmisch lần đầu dùng cụm từ <span class="popover-wrap"><button class="popover-trigger">software engineering</button><span class="popover-bubble">Software engineering — thuật ngữ ra đời ở hội nghị NATO năm 1968 khi ngành phần mềm rơi vào "khủng hoảng phần mềm": dự án vượt ngân sách, trễ hạn, đầy lỗi. Người ta nhận ra viết phần mềm cần kỷ luật kỹ thuật như xây cầu, không chỉ là nghệ thuật cá nhân.</span></span> để đối phó với "khủng hoảng phần mềm." Năm 2025, <strong class="text-white">Andrej Karpathy</strong> tuyên bố: <em>"Ngôn ngữ lập trình hot nhất bây giờ là tiếng Anh."</em> Nhưng giữa hai mốc đó, có một sự thật không đổi: <span class="hl">phần mềm cần người hiểu cách hệ thống chạy</span> — không chỉ người biết gõ prompt.</p>

    <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-4">Tôi viết bản đồ này cho người muốn trở thành kỹ sư backend thật trong kỷ nguyên AI — không phải coder copy-paste. Lộ trình dùng <strong class="text-white">Go</strong> vì ba lý do thực dụng:</p>

    <ul class="space-y-2 text-base text-slate-300 ml-4 mb-6">
      <li>• Cú pháp tối thiểu — bạn dành thời gian học <em>hệ thống</em>, không phải học <em>ngôn ngữ</em>.</li>
      <li>• Standard library mạnh — <code class="bg-slate-900/60 px-1.5 py-0.5 text-cyan-300 text-sm">net/http</code> đủ để xây production server không cần framework.</li>
      <li>• Concurrency primitives (<span class="popover-wrap"><button class="popover-trigger">goroutine</button><span class="popover-bubble">Goroutine — đơn vị thực thi nhẹ trong Go, do runtime quản lý chứ không phải OS. Một process Go có thể chạy hàng trăm nghìn goroutine song song với chi phí RAM cực thấp (vài KB mỗi goroutine), so với thread OS truyền thống tốn ~1MB.</span></span>, channel) buộc bạn nghĩ về race condition và state — kỹ năng cần cho mọi backend engineer.</li>
    </ul>
  </section>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- STATS                                                  -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="stat-card">
        <div class="stat-num">~$140K</div>
        <div class="stat-label">Lương trung bình Go dev (US, 2025)</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">#3</div>
        <div class="stat-label">Ngôn ngữ "muốn học nhất" (Stack Overflow)</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">26</div>
        <div class="stat-label">Tuần học có cấu trúc (≈10h/tuần)</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">6</div>
        <div class="stat-label">Project thực tế đi từ 0 đến deploy</div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════ -->
  <!-- MENTAL MODEL — REQUEST FLOW                            -->
  <!-- ══════════════════════════════════════════════════════ -->
  <div class="h-px w-full bg-cyan-900/30"></div>

  <section>
    <span class="section-num">§ 01</span>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 tracking-tight">Một Request Đi Đâu? — Mô Hình Tinh Thần</h2>
    <p class="text-slate-400 text-base md:text-lg mb-6">Trước khi học bất cứ thứ gì, bạn phải vẽ được con đường mà một byte đi từ phím bấm trên trình duyệt đến database — và quay về.</p>

    <div class="flow-row">
      <div class="flow-node"><div class="fn-label">L1</div><div class="fn-name">Browser</div></div>
      <div class="flow-arr">→</div>
      <div class="flow-node"><div class="fn-label">L2</div><div class="fn-name">DNS</div></div>
      <div class="flow-arr">→</div>
      <div class="flow-node"><div class="fn-label">L3</div><div class="fn-name">TCP / TLS</div></div>
      <div class="flow-arr">→</div>
      <div class="flow-node"><div class="fn-label">L4</div><div class="fn-name">HTTP</div></div>
    </div>
    <div class="flow-row">
      <div class="flow-node"><div class="fn-label">L5</div><div class="fn-name">Load Balancer</div></div>
      <div class="flow-arr">→</div>
      <div class="flow-node"><div class="fn-label">L6</div><div class="fn-name">Go Server</div></div>
      <div class="flow-arr">→</div>
      <div class="flow-node"><div class="fn-label">L7</div><div class="fn-name">Cache / DB</div></div>
      <div class="flow-arr">→</div>
      <div class="flow-node"><div class="fn-label">L8</div><div class="fn-name">Response</div></div>
    </div>

    <p class="text-base md:text-lg text-slate-300 leading-relaxed mt-6 mb-4">Tám lớp. Mỗi lớp có giao thức riêng, lỗi riêng, công cụ debug riêng. Người mới thường dồn 90% thời gian vào L6 (viết code) và bỏ qua L1–L5. Đó là lý do họ <span class="hl-red">debug bằng cách thử-sai</span> thay vì suy luận hệ thống.</p>

    <p class="text-base md:text-lg text-slate-300 leading-relaxed">Lộ trình này dạy đi từ <strong class="text-white">L1 ngược về L7</strong> — bạn hiểu môi trường trước khi viết server. Khi production sập, bạn biết <em>nhìn vào tầng nào</em>.</p>

    <details class="expand-block">
      <summary>
        <svg class="chevron w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        Tại sao không học framework trước cho nhanh?
      </summary>
      <div class="expand-content">
        <p class="mb-3">Frameworks (Express, Spring, Rails, NestJS) ẩn đi tầng L3–L5. Bạn gọi <code>app.get('/users')</code> mà không biết <span class="popover-wrap"><button class="popover-trigger">TCP three-way handshake</button><span class="popover-bubble">TCP three-way handshake — quá trình bắt tay 3 bước (SYN → SYN-ACK → ACK) để thiết lập kết nối TCP. Là lý do mở connection mới luôn tốn vài chục ms — và là lý do connection pooling tồn tại.</span></span> đã chạy chưa, request có bị buffer không, body parser ăn bao nhiêu RAM. Khi quy mô tăng, abstraction rò rỉ — và bạn không có ngôn ngữ để mô tả vấn đề.</p>
        <p>Go bắt bạn nhìn thấy tầng dưới hơn. Đó là tính năng, không phải bug.</p>
      </div>
    </details>
  </section>

