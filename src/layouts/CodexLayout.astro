---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  /** Course-style label, e.g. "BACKEND // FUNDAMENTALS // DNS" */
  kicker?: string;
  /** Volume identifier, e.g. "CODEX // VOL III // CHAPTER 02" */
  volumeId?: string;
  /** Estimated reading time, e.g. "~50 min" */
  duration?: string;
  /** Difficulty: "Beginner" | "Intermediate" | "Advanced" */
  level?: string;
  /** Canonical URL */
  canonicalUrl?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  kicker,
  volumeId,
  duration,
  level,
  canonicalUrl,
} = Astro.props;

const formattedDate = pubDate.toISOString().split('T')[0];
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="codex-bg text-[#1c1a16] font-serif min-h-screen"
  canonicalUrl={canonicalUrl}
>
  <style is:global>
    /* ─── Page surface ──────────────────────────── */
    .codex-bg {
      background-color: #f4ede0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent 0px,
          transparent 31px,
          rgba(28, 26, 22, 0.06) 31px,
          rgba(28, 26, 22, 0.06) 32px
        ),
        radial-gradient(ellipse at top, rgba(155, 28, 46, 0.04), transparent 70%);
      background-attachment: fixed;
    }
    .codex-bg main, .codex-bg header, .codex-bg nav, .codex-bg footer {
      position: relative; z-index: 1;
    }

    /* ─── Typography defaults inside codex ─────── */
    .codex-bg h2, .codex-bg h3, .codex-bg h4 {
      font-family: var(--font-editorial);
      color: #1c1a16;
      letter-spacing: -0.01em;
    }
    .codex-bg p {
      font-family: var(--font-serif);
      color: #2a2620;
      line-height: 1.7;
    }
    .codex-bg code, .codex-bg pre, .codex-bg .mono {
      font-family: var(--font-ibm-mono);
    }

    /* ─── Drop cap for first paragraph after H2 ── */
    .codex-bg .dropcap::first-letter {
      font-family: var(--font-editorial);
      float: left;
      font-size: 4.4rem;
      line-height: 0.92;
      padding: 6px 12px 0 0;
      color: #8b1a1a;
      font-weight: 700;
    }

    /* ─── Section heading numerals ─────────────── */
    .codex-bg .chapter-num {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-ibm-mono);
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #8b1a1a;
      margin-bottom: 14px;
    }
    .codex-bg .chapter-num::before {
      content: '';
      width: 28px; height: 1px; background: #8b1a1a;
    }

    /* ─── Inline highlights ───────────────────── */
    .codex-bg .ink {
      background: rgba(139, 26, 26, 0.08);
      color: #8b1a1a;
      padding: 1px 6px;
      font-weight: 700;
      box-shadow: 0 1px 0 rgba(139, 26, 26, 0.4);
    }
    .codex-bg .gold {
      background: rgba(192, 142, 46, 0.18);
      color: #6b4f1f;
      padding: 1px 6px;
      font-weight: 700;
      box-shadow: 0 1px 0 rgba(192, 142, 46, 0.5);
    }
    .codex-bg .navy {
      background: rgba(12, 35, 64, 0.08);
      color: #0c2340;
      padding: 1px 6px;
      font-weight: 700;
      box-shadow: 0 1px 0 rgba(12, 35, 64, 0.4);
    }
    .codex-bg .moss {
      background: rgba(46, 89, 47, 0.10);
      color: #2e592f;
      padding: 1px 6px;
      font-weight: 700;
      box-shadow: 0 1px 0 rgba(46, 89, 47, 0.4);
    }

    /* ─── Inline code ─────────────────────────── */
    .codex-bg .icode {
      font-family: var(--font-ibm-mono);
      background: #1c1a16;
      color: #f4ede0;
      padding: 2px 7px;
      font-size: 0.86em;
      letter-spacing: -0.01em;
    }

    /* ─── Popovers (glossary tooltips) ────────── */
    .codex-bg .pop {
      position: relative; display: inline;
    }
    .codex-bg .pop-trig {
      color: #0c2340;
      border-bottom: 1px dashed rgba(12, 35, 64, 0.55);
      cursor: help; background: none;
      border-top: none; border-left: none; border-right: none;
      font: inherit; padding: 0;
      font-weight: 700;
    }
    .codex-bg .pop-trig:hover {
      border-bottom-color: #0c2340;
      color: #8b1a1a;
    }
    .codex-bg .pop-bub {
      display: none; position: absolute;
      bottom: calc(100% + 10px); left: 50%;
      transform: translateX(-50%); width: 320px;
      padding: 14px 16px;
      background: #1c1a16; color: #f4ede0;
      font-family: var(--font-serif);
      font-size: 0.92rem; line-height: 1.55;
      box-shadow: 6px 6px 0 rgba(28, 26, 22, 0.15);
      z-index: 50; text-align: left;
    }
    .codex-bg .pop-bub::after {
      content: ''; position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 7px solid transparent;
      border-top-color: #1c1a16;
    }
    .codex-bg .pop-bub.show { display: block; }
    @media (max-width: 640px) {
      .codex-bg .pop-bub { width: 250px; left: 0; transform: none; }
      .codex-bg .pop-bub::after { left: 22px; transform: none; }
    }

    /* ─── Expandable detail block ─────────────── */
    .codex-bg .codex-detail {
      border: 1.5px solid #1c1a16;
      background: rgba(255, 252, 244, 0.6);
      margin: 1.5rem 0;
      box-shadow: 4px 4px 0 rgba(28, 26, 22, 0.1);
    }
    .codex-bg .codex-detail summary {
      cursor: pointer; padding: 14px 18px;
      font-family: var(--font-ibm-mono);
      font-size: 0.78rem; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: #1c1a16;
      display: flex; align-items: center; gap: 10px;
      list-style: none; user-select: none;
      border-bottom: 1.5px solid transparent;
    }
    .codex-bg .codex-detail summary::-webkit-details-marker { display: none; }
    .codex-bg .codex-detail[open] summary {
      border-bottom-color: #1c1a16;
      background: #1c1a16;
      color: #f4ede0;
    }
    .codex-bg .codex-detail summary .chev { transition: transform 0.25s; flex-shrink: 0; }
    .codex-bg .codex-detail[open] summary .chev { transform: rotate(90deg); }
    .codex-bg .codex-detail .codex-detail-body {
      padding: 18px;
      font-family: var(--font-serif);
      font-size: 1rem; line-height: 1.7; color: #2a2620;
    }

    /* ─── Stat callout cards ──────────────────── */
    .codex-bg .stat-card {
      background: #fffaf0;
      border: 1.5px solid #1c1a16;
      padding: 18px;
      box-shadow: 4px 4px 0 rgba(28, 26, 22, 0.12);
      text-align: left;
    }
    .codex-bg .stat-num {
      font-family: var(--font-editorial);
      font-size: 2.2rem; font-weight: 700;
      color: #8b1a1a; line-height: 1;
      margin-bottom: 8px;
    }
    .codex-bg .stat-label {
      font-family: var(--font-ibm-mono);
      font-size: 0.72rem;
      color: #5a5044;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      line-height: 1.4;
    }

    /* ─── Pullquote / margin note ─────────────── */
    .codex-bg .pullquote {
      border-left: 3px solid #8b1a1a;
      padding: 8px 0 8px 24px;
      margin: 1.5rem 0;
      font-family: var(--font-editorial);
      font-style: italic;
      font-size: 1.4rem;
      line-height: 1.45;
      color: #1c1a16;
    }

    /* ─── Figure caption ───────────────────────── */
    .codex-bg figure {
      margin: 1.8rem 0;
    }
    .codex-bg figcaption {
      font-family: var(--font-ibm-mono);
      font-size: 0.74rem;
      color: #5a5044;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-top: 10px;
      padding-top: 8px;
      border-top: 1px solid rgba(28, 26, 22, 0.3);
    }
    .codex-bg figcaption .fig-label {
      color: #8b1a1a; font-weight: 700; margin-right: 8px;
    }

    /* ─── Hierarchy tree (DNS-style) ──────────── */
    .codex-bg .tree {
      font-family: var(--font-ibm-mono);
      background: #fffaf0;
      border: 1.5px solid #1c1a16;
      padding: 24px;
      box-shadow: 4px 4px 0 rgba(28, 26, 22, 0.12);
      overflow-x: auto;
    }
    .codex-bg .tree-line {
      display: flex; align-items: baseline;
      font-size: 0.88rem;
      line-height: 1.7;
      color: #1c1a16;
      white-space: nowrap;
    }
    .codex-bg .tree-line .tree-label {
      color: #8b1a1a; font-weight: 700;
    }
    .codex-bg .tree-line .tree-meta {
      color: #5a5044; margin-left: 14px;
      font-size: 0.78rem;
    }

    /* ─── Flow diagram (resolver steps) ───────── */
    .codex-bg .flow {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 16px;
      margin: 1rem 0;
    }
    .codex-bg .flow-step {
      display: contents;
    }
    .codex-bg .flow-num {
      grid-column: 1;
      width: 48px; height: 48px;
      background: #1c1a16; color: #f4ede0;
      font-family: var(--font-editorial);
      font-size: 1.3rem; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .codex-bg .flow-card {
      grid-column: 2;
      background: #fffaf0;
      border: 1.5px solid #1c1a16;
      padding: 14px 16px;
      box-shadow: 3px 3px 0 rgba(28, 26, 22, 0.12);
    }
    .codex-bg .flow-card .fc-from {
      font-family: var(--font-ibm-mono);
      font-size: 0.7rem;
      color: #8b1a1a;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .codex-bg .flow-card .fc-title {
      font-family: var(--font-editorial);
      font-size: 1.05rem; font-weight: 700;
      color: #1c1a16; margin-bottom: 4px;
    }
    .codex-bg .flow-card .fc-body {
      font-family: var(--font-serif);
      font-size: 0.95rem; color: #2a2620;
      line-height: 1.55;
    }

    /* ─── Comparison / record table ───────────── */
    .codex-bg .codex-table {
      width: 100%; border-collapse: collapse;
      font-family: var(--font-serif);
      font-size: 0.95rem;
      background: #fffaf0;
      border: 1.5px solid #1c1a16;
      box-shadow: 4px 4px 0 rgba(28, 26, 22, 0.12);
    }
    .codex-bg .codex-table th {
      padding: 12px 14px;
      background: #1c1a16; color: #f4ede0;
      font-family: var(--font-ibm-mono);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-align: left;
    }
    .codex-bg .codex-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(28, 26, 22, 0.18);
      vertical-align: top;
      color: #2a2620;
    }
    .codex-bg .codex-table tr:last-child td { border-bottom: none; }
    .codex-bg .codex-table tr:hover td { background: rgba(192, 142, 46, 0.06); }
    .codex-bg .codex-table .col-key {
      font-family: var(--font-ibm-mono);
      font-weight: 700;
      color: #8b1a1a;
    }

    /* ─── Latency / bar chart ─────────────────── */
    .codex-bg .bar-row {
      display: flex; align-items: center; gap: 14px; margin-bottom: 12px;
    }
    .codex-bg .bar-name {
      font-family: var(--font-ibm-mono);
      font-size: 0.85rem;
      color: #1c1a16;
      width: 230px; flex-shrink: 0;
    }
    .codex-bg .bar-track {
      flex: 1; height: 28px;
      background: #fffaf0;
      border: 1.5px solid #1c1a16;
      box-shadow: 2px 2px 0 rgba(28, 26, 22, 0.1);
    }
    .codex-bg .bar-fill {
      height: 100%;
      display: flex; align-items: center;
      padding-left: 10px;
      font-family: var(--font-ibm-mono);
      font-size: 0.72rem; font-weight: 700;
      color: #1c1a16;
    }
    @media (max-width: 640px) {
      .codex-bg .bar-name { width: 130px; font-size: 0.75rem; }
    }

    /* ─── Cache layer stack ──────────────────── */
    .codex-bg .cache-stack {
      display: grid; gap: 0;
      border: 1.5px solid #1c1a16;
      box-shadow: 4px 4px 0 rgba(28, 26, 22, 0.12);
    }
    .codex-bg .cache-row {
      display: grid;
      grid-template-columns: 90px 1fr 1fr;
      border-bottom: 1.5px solid #1c1a16;
      background: #fffaf0;
    }
    .codex-bg .cache-row:last-child { border-bottom: none; }
    .codex-bg .cache-row .c-tier {
      padding: 14px 14px;
      background: #1c1a16; color: #f4ede0;
      font-family: var(--font-ibm-mono);
      font-size: 0.7rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      display: flex; align-items: center;
    }
    .codex-bg .cache-row .c-name {
      padding: 14px 14px;
      font-family: var(--font-editorial);
      font-size: 1rem; font-weight: 700;
      color: #1c1a16;
      border-right: 1px solid rgba(28, 26, 22, 0.2);
    }
    .codex-bg .cache-row .c-note {
      padding: 14px 14px;
      font-family: var(--font-serif);
      font-size: 0.92rem;
      color: #2a2620;
    }
    @media (max-width: 768px) {
      .codex-bg .cache-row { grid-template-columns: 80px 1fr; }
      .codex-bg .cache-row .c-note {
        grid-column: 1 / -1;
        border-top: 1px solid rgba(28, 26, 22, 0.15);
      }
    }

    /* ─── Packet anatomy ─────────────────────── */
    .codex-bg .packet {
      display: flex; flex-wrap: wrap; gap: 0;
      border: 1.5px solid #1c1a16;
      box-shadow: 4px 4px 0 rgba(28, 26, 22, 0.12);
    }
    .codex-bg .packet .pk-seg {
      flex: 1; min-width: 130px;
      padding: 12px 14px;
      font-family: var(--font-ibm-mono);
      font-size: 0.78rem;
      color: #1c1a16;
      text-align: center;
      border-right: 1.5px solid #1c1a16;
    }
    .codex-bg .packet .pk-seg:last-child { border-right: none; }
    .codex-bg .packet .pk-seg .pk-label {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 4px;
      opacity: 0.75;
    }
    .codex-bg .pk-hdr { background: #c08e2e; color: #1c1a16; }
    .codex-bg .pk-q { background: #8b1a1a; color: #f4ede0; }
    .codex-bg .pk-a { background: #2e592f; color: #f4ede0; }
    .codex-bg .pk-auth { background: #0c2340; color: #f4ede0; }
    .codex-bg .pk-add { background: #5a5044; color: #f4ede0; }

    /* ─── Pitfall / red-flag block ────────────── */
    .codex-bg .pitfall {
      background: rgba(139, 26, 26, 0.06);
      border-left: 4px solid #8b1a1a;
      padding: 16px 18px;
      margin-bottom: 14px;
    }
    .codex-bg .pitfall .pf-num {
      font-family: var(--font-ibm-mono);
      font-size: 0.7rem; font-weight: 700;
      color: #8b1a1a;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .codex-bg .pitfall .pf-title {
      font-family: var(--font-editorial);
      font-size: 1.05rem; font-weight: 700;
      color: #1c1a16;
      margin-bottom: 6px;
    }
    .codex-bg .pitfall .pf-body {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      color: #2a2620;
      line-height: 1.6;
    }

    /* ─── Timeline (history of incidents) ────── */
    .codex-bg .timeline { position: relative; padding-left: 28px; margin: 1.5rem 0; }
    .codex-bg .timeline::before {
      content: ''; position: absolute; left: 8px; top: 8px; bottom: 8px;
      width: 2px; background: #1c1a16;
    }
    .codex-bg .tl-event { position: relative; padding-bottom: 22px; }
    .codex-bg .tl-event::before {
      content: ''; position: absolute; left: -25px; top: 6px;
      width: 11px; height: 11px;
      background: #f4ede0;
      border: 2px solid #8b1a1a;
      border-radius: 50%;
    }
    .codex-bg .tl-event .tl-date {
      font-family: var(--font-ibm-mono);
      font-size: 0.74rem; font-weight: 700;
      color: #8b1a1a;
      letter-spacing: 0.1em;
      margin-bottom: 4px;
    }
    .codex-bg .tl-event .tl-title {
      font-family: var(--font-editorial);
      font-size: 1.1rem;
      font-weight: 700;
      color: #1c1a16;
      margin-bottom: 4px;
    }
    .codex-bg .tl-event .tl-body {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      color: #2a2620;
      line-height: 1.6;
    }

    /* ─── Lab callout (works-like-this) ──────── */
    .codex-bg .lab {
      background: #1c1a16; color: #f4ede0;
      padding: 18px 20px;
      border: 1.5px solid #1c1a16;
      box-shadow: 4px 4px 0 rgba(28, 26, 22, 0.18);
      margin: 1.5rem 0;
    }
    .codex-bg .lab .lab-label {
      font-family: var(--font-ibm-mono);
      font-size: 0.7rem;
      color: #c08e2e;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .codex-bg .lab pre {
      font-family: var(--font-ibm-mono);
      font-size: 0.85rem;
      line-height: 1.6;
      white-space: pre-wrap;
      color: #f4ede0;
      margin: 0;
    }
    .codex-bg .lab .lab-comment {
      color: #c08e2e;
    }
    .codex-bg .lab .lab-result {
      color: #94d68b;
    }

    /* ─── Section divider (ornament) ─────────── */
    .codex-bg .ornament {
      display: flex; align-items: center;
      gap: 16px; justify-content: center;
      color: #8b1a1a;
      font-family: var(--font-editorial);
      letter-spacing: 0.4em;
      margin: 0 auto;
    }
    .codex-bg .ornament::before, .codex-bg .ornament::after {
      content: ''; flex: 1 1 80px; height: 1px;
      background: rgba(28, 26, 22, 0.5);
      max-width: 200px;
    }
  </style>

  <!-- ════════════ NAV ════════════ -->
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex justify-between items-center border-b border-[#1c1a16]/30">
    <div class="flex items-center gap-3">
      <a href="/" class="inline-flex items-center justify-center w-9 h-9 border-[1.5px] border-[#1c1a16] text-[#1c1a16] hover:bg-[#1c1a16] hover:text-[#f4ede0] transition-colors no-underline text-lg leading-none">&larr;</a>
      <a href="/" class="no-underline">
        <Logo variant="mars" size={36} />
      </a>
    </div>
    <div class="font-mono text-[10px] tracking-[0.22em] text-[#8b1a1a] uppercase hidden sm:block">
      {volumeId ?? 'CODEX'}
    </div>
  </nav>

  <!-- ════════════ MAIN ════════════ -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16 text-lg">
    <!-- Title plate -->
    <header class="border-[1.5px] border-[#1c1a16] bg-[#fffaf0] shadow-[6px_6px_0_rgba(28,26,22,0.15)]">
      <div class="flex items-center justify-between border-b-[1.5px] border-[#1c1a16] px-5 sm:px-7 py-3 font-mono text-[10px] tracking-[0.22em] uppercase bg-[#1c1a16] text-[#f4ede0]">
        <span class="text-[#c08e2e]">{kicker ?? 'CODEX'}</span>
        <span class="text-[#f4ede0]/70 hidden sm:inline">{formattedDate}</span>
      </div>
      <div class="px-5 sm:px-7 py-7">
        <h1 class="text-3xl md:text-5xl font-bold text-[#1c1a16] mb-5 tracking-tight font-[family-name:var(--font-editorial)] leading-[1.08]">
          {title}
        </h1>
        <p class="text-[#3a342b] text-base md:text-xl leading-relaxed mb-6 font-[family-name:var(--font-serif)] italic">
          {description}
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5 pt-5 border-t border-[#1c1a16]/30">
          <div>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-[#8b1a1a] mb-1">Volume</div>
            <div class="font-mono text-sm text-[#1c1a16]">{volumeId ?? '—'}</div>
          </div>
          <div>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-[#8b1a1a] mb-1">Reading</div>
            <div class="font-mono text-sm text-[#1c1a16]">{duration ?? '—'}</div>
          </div>
          <div>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-[#8b1a1a] mb-1">Level</div>
            <div class="font-mono text-sm text-[#1c1a16]">{level ?? '—'}</div>
          </div>
          <div>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-[#8b1a1a] mb-1">Tags</div>
            <div class="font-mono text-sm text-[#5a5044] flex flex-wrap gap-x-2">
              {tags.map(tag => <span>#{tag}</span>)}
            </div>
          </div>
        </div>
      </div>
    </header>

    <slot />
  </main>

  <Footer variant="codex" />
</BaseLayout>
